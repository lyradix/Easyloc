<?php

namespace EasyLoc\Repository;
use Doctrine\DBAL\Connection;

class ContractRepository
{
    private Connection $conn;

    public function __construct(Connection $conn)
    {
        $this->conn = $conn;
    }

    public function findAll(): array
    {
        $sql = 'SELECT 
                ID as id,
                VEHICLE_UID as vehicle_uid,
                CUSTOMER_UID as customer_uid,
                SIGN_DATETIME as SignDate,
                LOC_BEGIN_DATETIME as StartDate,
                LOC_END_DATETIME as EndDate,
                RETURNING_DATETIME as ReturnDate,
                PRICE as Price
                FROM Contract 
                ORDER BY LOC_BEGIN_DATETIME DESC';
        $result = $this->conn->executeQuery($sql);
        return $result->fetchAllAssociative();
    }

    public function find(int $id): ?array
    {
        try {
            $sql = 'SELECT 
                    ID as id,
                    VEHICLE_UID as vehicle_uid,
                    CUSTOMER_UID as customer_uid,
                    SIGN_DATETIME as SignDate,
                    LOC_BEGIN_DATETIME as StartDate,
                    LOC_END_DATETIME as EndDate,
                    RETURNING_DATETIME as ReturnDate,
                    PRICE as Price
                    FROM Contract 
                    WHERE ID = ?';
            
            // Log the query and parameters for debugging
            error_log("Contract query: " . $sql);
            error_log("Contract ID: " . $id);
            
            $stmt = $this->conn->prepare($sql);
            $result = $stmt->executeQuery([$id]);
            $contract = $result->fetchAssociative();
            
            if (!$contract) {
                error_log("No contract found with ID: " . $id);
            }

            return $contract ?: null;
        } catch (\Exception $e) {
            error_log("Error in find method: " . $e->getMessage());
            throw $e;
        }
    }

    public function updateContract(int $id, array $data): void
    {
        $data['id'] = $id;
        $sql = "UPDATE Contract SET 
                VEHICLE_UID = :vehicle_uid, 
                CUSTOMER_UID = :customer_uid, 
                SIGN_DATETIME = :SignDate, 
                LOC_BEGIN_DATETIME = :StartDate, 
                LOC_END_DATETIME = :EndDate, 
                RETURNING_DATETIME = :ReturnDate, 
                PRICE = :Price
                WHERE id = :id";
        $stmt = $this->conn->prepare($sql);
        $stmt->executeStatement($data);
    }

    /**
     * Delete a contract by its ID
     */
    public function delete(int $id): void
    {
        try {
            $sql = "DELETE FROM Contract WHERE ID = ?";
            $stmt = $this->conn->prepare($sql);
            $stmt->executeQuery([$id]);
        } catch (\Exception $e) {
            error_log("Error deleting contract: " . $e->getMessage());
            throw $e;
        }
    }
}
